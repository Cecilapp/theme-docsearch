{#- DocSearch library and initialization, replacing the `container` element by the search button -#}
{%- set options = site.docsearch|default({}) -%}
{%- if (options.enabled ?? true) and options.appId|default and options.apiKey|default and options.indexName|default -%}
{#- keyword search only (`docsearch.min.js`), or keyword search and Ask AI (`index.min.js`) #}
{%- set library = options.library|default('https://cdn.jsdelivr.net/npm/@docsearch/js@%s/dist/umd/%s.min.js'|format(options.version|default('5'), options.askAi|default ? 'index' : 'docsearch')) -%}
{%- set search_parameters = options.search_parameters|default({}) -%}
{%- if options.language ?? true -%}
{%- set search_parameters = {facetFilters: ['lang:' ~ site.language]}|merge(search_parameters) -%}
{%- endif -%}
{%- set index = {name: '' ~ options.indexName} -%}
{%- if search_parameters is not empty -%}
{%- set index = index|merge({searchParameters: search_parameters}) -%}
{%- endif -%}
{%- set config = {
  container: options.container|default('#docsearch'),
  appId: '' ~ options.appId,
  apiKey: '' ~ options.apiKey,
  indices: [index],
  insights: options.insights ?? false,
  translations: {
    button: {
      buttonText: 'Search'|trans,
      buttonAriaLabel: 'Search'|trans
    },
    modal: {
      searchBox: {
        placeholderText: options.placeholder|default('Search docs'|trans),
        searchInputLabel: 'Search'|trans,
        clearButtonTitle: 'Clear'|trans,
        clearButtonAriaLabel: 'Clear the query'|trans,
        closeButtonText: 'Close'|trans,
        closeButtonAriaLabel: 'Close'|trans
      },
      startScreen: {
        recentSearchesTitle: 'Recent'|trans,
        saveRecentSearchButtonTitle: 'Save this search'|trans,
        removeRecentSearchButtonTitle: 'Remove this search from history'|trans,
        favoriteSearchesTitle: 'Favorite'|trans,
        removeFavoriteSearchButtonTitle: 'Remove this search from favorites'|trans
      },
      errorScreen: {
        titleText: 'Unable to fetch results'|trans,
        helpText: 'You might want to check your network connection.'|trans
      },
      footer: {
        selectText: 'to select'|trans,
        selectKeyAriaLabel: 'Enter key'|trans,
        navigateText: 'to navigate'|trans,
        navigateUpKeyAriaLabel: 'Arrow up'|trans,
        navigateDownKeyAriaLabel: 'Arrow down'|trans,
        closeText: 'to close'|trans,
        closeKeyAriaLabel: 'Escape key'|trans,
        poweredByText: 'Powered by'|trans
      },
      noResultsScreen: {
        noResultsText: 'No results for'|trans,
        suggestedQueryText: 'Try searching for'|trans,
        reportMissingResultsText: 'Believe this query should return results?'|trans,
        reportMissingResultsLinkText: 'Let us know.'|trans
      }
    }
  }
} -%}
{%- if options.askAi|default -%}
{%- set config = config|merge({askAi: options.askAi}) -%}
{%- endif %}
{{ html(asset(library, {filename: 'docsearch.min.js', minify: false}), {id: 'docsearch-js', defer: ''}) }}
{#- JSON_HEX_TAG | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE #}
<script>
  document.getElementById('docsearch-js').addEventListener('load', function () {
    docsearch({{ config|json_encode(1 b-or 64 b-or 256)|raw }});
  });
</script>
{%- endif -%}