{#- DocSearch <head> tags: language meta (used by the crawler), Algolia preconnect, stylesheet, button states and resets -#}
{%- set options = site.docsearch|default({}) -%}
{%- if (options.enabled ?? true) and options.appId|default and options.apiKey|default and options.indexName|default -%}
{%- set stylesheet = options.stylesheet|default('https://cdn.jsdelivr.net/npm/@docsearch/css@%s/dist/style.min.css'|format(options.version|default('5'))) %}
<meta name="docsearch:language" content="{{ site.language }}">
<link rel="preconnect" href="https://{{ options.appId }}-dsn.algolia.net" crossorigin>
{{ html(asset(stylesheet, {filename: 'docsearch.min.css'})) }}
{#- search button states, and resets of the styles of classless CSS frameworks (e.g. Pico CSS, used by Cecil's default layout) inside the search modal #}
<style>{% apply minify_css %}
  /* search button: accent border on hover and keyboard focus */
  .DocSearch-Button:hover,
  .DocSearch-Button:focus-visible {
    border-color: var(--docsearch-search-button-hover-border-color, var(--docsearch-highlight-color));
  }
  @media (prefers-reduced-motion: no-preference) {
    .DocSearch-Button {
      transition: border-color .2s, box-shadow .2s;
    }
  }
  /* the modal backdrop has a `button` role */
  .DocSearch-Container {
    padding: 0;
    border: 0;
    border-radius: 0;
  }
  .DocSearch-Modal {
    text-align: start;
  }
  .DocSearch-Modal mark {
    padding: 0;
  }
  .DocSearch-Modal li,
  .DocSearch-Modal section {
    margin-bottom: 0;
  }
  .DocSearch-Modal kbd {
    padding: 0;
    font-weight: normal;
  }
  .DocSearch-Hit-icon svg {
    display: block;
  }
  .DocSearch-Modal button {
    margin-bottom: 0;
  }
  .DocSearch-Modal button,
  .DocSearch-Modal button:focus {
    box-shadow: none;
  }
  /* `height: auto`: the search bar has a fixed height, but a padding relative to the font size, which crops the input text when the root font size is larger than 16px */
  .DocSearch-Modal input.DocSearch-Input {
    height: auto;
    margin: 0;
    padding: 0 0 0 8px;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: var(--docsearch-text-color);
    font-size: 1rem;
    line-height: 1.4;
  }
{% endapply %}</style>
{%- endif -%}